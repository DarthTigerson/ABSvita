# Host (macOS/Linux) build of the hardware-independent core + unit tests.
#   make -f Makefile.host test
CC      ?= cc
# libmpg123 and libcurl: pkg-config when available (Linux CI), else Homebrew
MPG_CFLAGS := $(shell pkg-config --cflags libmpg123 2>/dev/null || echo -I/opt/homebrew/opt/mpg123/include)
MPG_LIBS   := $(shell pkg-config --libs libmpg123 2>/dev/null || echo -L/opt/homebrew/opt/mpg123/lib -lmpg123)
BUILD   := build-host
CFLAGS  := -DAPP_VERSION=\"0.1.0\" -std=gnu11 -O1 -g -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare \
           -fsanitize=address,undefined -fno-omit-frame-pointer \
           -Isrc -Isrc/core -Isrc/net -Isrc/ui $(MPG_CFLAGS) -Ivendor/cjson -Ivendor/sonic -Ivendor/helix-aac -Ivendor/stb -Itests
LDFLAGS := -fsanitize=address,undefined -lm -lcurl $(MPG_LIBS) -lpthread

CORE    := $(wildcard src/core/*.c) $(wildcard src/net/*.c) src/ui/icons.c
VENDOR  := vendor/cjson/cJSON.c vendor/sonic/sonic.c $(wildcard vendor/helix-aac/*.c)
TESTS   := $(wildcard tests/*.c)
OBJS    := $(patsubst %.c,$(BUILD)/%.o,$(CORE) $(VENDOR) $(TESTS))

.PHONY: test nettest clean fixtures
test: $(BUILD)/tests_run fixtures
	./$(BUILD)/tests_run

# Runs every suite with the network tests enabled against a local mock server.
MOCK_PORT ?= 18081
nettest: $(BUILD)/tests_run fixtures
	@sh tools/gen_media.sh tests/media >/dev/null
	@python3 tools/mock_abs.py --port $(MOCK_PORT) --host 127.0.0.1 > $(BUILD)/mock.log 2>&1 & echo $$! > $(BUILD)/mock.pid; sleep 1.5; \
	MOCK_ABS=http://127.0.0.1:$(MOCK_PORT) ./$(BUILD)/tests_run; rc=$$?; kill `cat $(BUILD)/mock.pid`; exit $$rc

fixtures:
	@sh tests/gen_fixtures.sh

$(BUILD)/tests_run: $(OBJS)
	$(CC) $^ $(LDFLAGS) -o $@

$(BUILD)/vendor/%.o: vendor/%.c
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 -O2 -g -w -fsanitize=address -Ivendor/helix-aac -Ivendor/cjson -Ivendor/sonic -c $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -c $< -o $@

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)
